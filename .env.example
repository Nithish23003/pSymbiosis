# Copy to .env (never commit .env). Load with your IDE run config or `export $(cat .env | xargs)`.
DB_URL=jdbc:postgresql://localhost:5432/perfinsight
DB_USERNAME=
DB_PASSWORD=

AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
# Audience of the access token your frontend requests, usually api://<client-id>
AZURE_API_AUDIENCE=

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
ADO_PAT=
TESTRAIL_USER=
TESTRAIL_API_KEY=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

AI_PROVIDER=none
AI_API_KEY=
